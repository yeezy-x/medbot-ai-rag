generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
}

enum IngestionStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

enum Role {
  USER
  DOCTOR
  RESEARCHER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DEACTIVATED
  PENDING_DELETION
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  LOGOUT_ALL
  REGISTER
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_SENT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  MFA_SETUP_STARTED
  MFA_ENABLED
  MFA_DISABLED
  MFA_CHALLENGE_SUCCESS
  MFA_CHALLENGE_FAILURE
  RECOVERY_CODES_REGENERATED
  SESSION_REVOKED
  ACCOUNT_LINKED
  ACCOUNT_UNLINKED
  EMAIL_CHANGED
  PROFILE_UPDATED
  ACCOUNT_DEACTIVATED
  ACCOUNT_DELETED
  ACCOUNT_EXPORTED
  STEP_UP_SUCCESS
  SUSPICIOUS_ACTIVITY
}

model User {
  id            String        @id @default(uuid())
  clerkId       String        @unique
  name          String
  email         String        @unique
  emailVerified DateTime?
  image         String?
  role          Role          @default(USER)
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sessions  ChatSession[]
  auditLogs AuditLog[]
}

model ChatSession {
  id        String    @id @default(uuid())
  title     String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]

  @@index([userId])
}

model Message {
  id        String      @id @default(uuid())
  role      MessageRole
  content   String
  sessionId String
  createdAt DateTime    @default(now())
  citations Citation[]
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Citation {
  id          String  @id @default(uuid())
  pageNumber  Int
  sourceTitle String
  chunkId     String
  messageId   String
  message     Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunk       Chunk   @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([chunkId])
}

model Document {
  id              String          @id @default(uuid())
  title           String
  fileName        String
  version         String
  language        String
  sourceType      String
  checksum        String?         @unique
  ingestionStatus IngestionStatus @default(PENDING)
  uploadedAt      DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  chunks          Chunk[]
}

model Chunk {
  id              String                       @id @default(uuid())
  documentId      String
  chunkIndex      Int
  content         String
  characterCount  Int
  estimatedTokens Int
  startOffset     Int
  endOffset       Int
  pageNumber      Int?
  chapter         String?
  section         String?
  headings        Json?
  embedding       Unsupported("vector(768)")?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  document        Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  citations       Citation[]

  @@index([documentId])
  @@index([chunkIndex])
  @@index([pageNumber])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}
